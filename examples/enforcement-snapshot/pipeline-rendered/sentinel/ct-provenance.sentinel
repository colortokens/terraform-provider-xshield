# ct-provenance - SOFT-MANDATORY (enforcement workspaces)
#
# Proves that every ColorTokens resource in the plan came from the approved
# rendering module driven by the snapshot data source - not from hand-written
# HCL, a local override, or a fork with injected rules.
#
# This is the implementable form of "rules provably derive from the approved
# snapshot": Sentinel verifies PROVENANCE and INTEGRITY rather than trying to
# recompute segmentation policy inside a policy engine.

import "tfconfig/v2" as tfconfig
import "tfplan/v2" as tfplan
import "strings"

param approved_module_source default "app.terraform.io/acme/ct-enforcement/aws"
param snapshot_data_type default "xshield_enforcement_snapshot"

# Permit local module paths (../modules/...). Pilot and development only -
# leave false in production.
param allow_local_module default false

# --- 1. the snapshot data source must be present -----------------------------

snapshot_data_sources = filter tfconfig.resources as _, r {
	r.mode is "data" and r.type is snapshot_data_type
}

has_snapshot_source = rule {
	length(snapshot_data_sources) > 0
}

# --- 2. every ct resource must originate from a module -----------------------

ct_resources = filter tfplan.resource_changes as _, rc {
	rc.mode is "managed" and
		rc.change.after is not null and
		((rc.change.after.tags else {}) contains "colortokens:managed" or
			strings.has_prefix(rc.change.after.name else "", "ct-") or
			strings.has_prefix(rc.change.after.name_prefix else "", "ct-"))
}

rendered_by_module = rule {
	all ct_resources as addr, rc {
		rc.module_address is not "" or
			print("DENIED:", addr, "- ColorTokens resources must come from the",
				"approved rendering module, not hand-written root-module HCL.") and false
	}
}

# --- 3. the module used must be the approved source --------------------------

module_calls = filter tfconfig.module_calls as _, mc {
	strings.has_prefix(mc.source, approved_module_source) or
		(allow_local_module and strings.has_prefix(mc.source, "../modules/"))
}

uses_approved_module = rule when length(ct_resources) > 0 {
	length(module_calls) > 0
}

main = rule {
	has_snapshot_source and
		rendered_by_module and
		uses_approved_module
}

# NOTE - deliberately not implemented here: a check that no rendered rule
# carries a literal peer hard-coded in configuration. Rule peers derive from
# computed data-source output, so at plan time they are unknown values and are
# not reliably distinguishable from literals in tfconfig alone. The provenance
# and integrity checks above cover the same tampering path (a fork or local
# override would fail the module-source check; altered rule content would fail
# the hash comparison in ct-version-integrity). Raise with us if your review
# requires a positive check rather than these two negative ones.
