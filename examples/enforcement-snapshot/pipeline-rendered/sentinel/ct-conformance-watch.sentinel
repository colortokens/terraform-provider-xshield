# ct-conformance-watch - ADVISORY
#
# Surfaces divergence inside the pipeline, at the moment of change, rather than
# only in the console after the fact.
#
# Quarantined assets are fail-secure (their policy is NOT rendered), so this is
# advisory by default - it must not block an otherwise-correct convergence run.
# Raise to soft-mandatory once an estate is steady-state and quarantine should
# genuinely be zero.

import "ct-common" as ct

param max_quarantined default 0

snaps = ct.snapshots()

quarantined = func() {
	total = 0
	for snaps as s {
		total += ct.value(s.quarantined_assets, 0)
	}
	return total
}

q = quarantined()

report_quarantine = func() {
	print("ADVISORY:", q, "asset(s) are quarantined in the resolved snapshot.")
	print("Their approved policy is NOT rendered (fail-secure) - they are running",
		"on whatever their segment group already grants.")
	print("Resolve in Xshield by promoting the divergence into a child segment,",
		"then re-run. Threshold:", max_quarantined)
	return true
}

# The run log carries the audit breadcrumb without anyone opening a console.
announce = func() {
	if length(snaps) is 0 {
		print("ColorTokens: no enforcement snapshot was read by this plan")
	}
	for snaps as s {
		print("ColorTokens: converging to snapshot version", s.version, "hash", s.content_hash)
	}
	return true
}

conformance_clean = rule {
	q <= max_quarantined or report_quarantine()
}

main = rule {
	announce() and conformance_clean
}
