# ct-version-integrity - SOFT-MANDATORY
#
# Closes the time-of-check/time-of-use window between plan and apply.
#
# The data source resolved the expected snapshot when the PLAN ran. By the time
# the APPLY gate evaluates, a security admin may have approved newer policy.
# This policy re-reads the expected version at gate time and fails the run if
# the plan was built from a different snapshot - the operator simply re-plans
# and converges. Stale policy can never reach the fabric.
#
# Requires the Sentinel http import to be enabled for the policy set and the
# snapshot API reachable from the Sentinel runtime. Sentinel cannot compute the
# provider's RSA-PSS request signature, so the endpoint must accept a bearer
# token for a principal that can only read the expected version.

import "http"
import "json"
import "ct-common" as ct

param xshield_api_base
param cloud_account_id
param region
param api_token default ""

expected_url = xshield_api_base + "/api/policies/cloudsnapshots/" +
	cloud_account_id + "/" + region + "/expected"

fetch_expected = func() {
	req = http.request(expected_url).with_header("Accept", "application/json")
	if api_token is not "" {
		req = req.with_header("Authorization", "Bearer " + api_token)
	}
	resp = http.accept_status_codes([200, 401, 403, 404, 500, 502, 503]).get(req)
	if resp.status_code is not 200 {
		print("FAILED: could not resolve the expected snapshot:", resp.status_code, expected_url)
		return null
	}
	return json.unmarshal(resp.body)
}

snaps = ct.snapshots()
expected = fetch_expected()

planned = func() {
	if length(snaps) is 1 {
		return snaps[0]
	}
	return null
}

built_from = planned()

api_reachable = rule {
	expected is not null
}

one_snapshot = rule {
	built_from is not null or
		print("DENIED: expected exactly one", ct.snapshot_type, "in this plan, found", length(snaps)) and false
}

matches_expected = rule when expected is not null and built_from is not null {
	built_from.content_hash is expected.contentHash or
		print("RE-PLAN REQUIRED: plan was built from snapshot version", built_from.version,
			"but Xshield now expects version", expected.version,
			"- policy changed after this plan; re-plan to converge.") and false
}

main = rule {
	api_reachable and one_snapshot and matches_expected
}
